:root {
  --color-fucsia: #EE00FF;
  --color-fondo: #FDF7FD;
  --color-contenedor: #FFFFFF;
  --color-texto: #2D2D2D;
  --color-label: #4A4A4A;
  --color-bordes: #E5C3E8;
  --color-input-bg: #FAFAFA;
  --color-card-bg: #FFF0FF;
}

body.modo-oscuro {
  --color-fondo: #121013;
  --color-contenedor: #1E1A20;
  --color-texto: #F5EBF7;
  --color-label: #D8C3DC;
  --color-bordes: #4A284D;
  --color-input-bg: #29232C;
  --color-card-bg: #2B162D;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  transition: background-color 0.3s, color 0.3s, border-color 0.3s;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: var(--color-fondo);
  color: var(--color-texto);
  padding: 25px 15px;
}

.contenedor-principal {
  max-width: 780px;
  margin: 0 auto;
  background: var(--color-contenedor);
  padding: 30px;
  border-radius: 16px;
  border: 2px solid var(--color-fucsia);
  box-shadow: 0 8px 25px rgba(238, 0, 255, 0.12);
}

.header-superior {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.badge-actualizacion {
  font-size: 0.8rem;
  font-weight: bold;
  color: var(--color-fucsia);
  background: var(--color-card-bg);
  padding: 6px 12px;
  border-radius: 12px;
  border: 1px solid var(--color-fucsia);
}

.btn-modo-toggle {
  background: var(--color-input-bg);
  border: 1.5px solid var(--color-bordes);
  border-radius: 50%;
  width: 38px;
  height: 38px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.titulo-pagina {
  color: var(--color-fucsia);
  text-align: center;
  font-size: 2.2rem;
  margin-bottom: 25px;
}

h2, h3 {
  color: var(--color-fucsia);
  margin-bottom: 15px;
}

.oculto {
  display: none !important;
}

/* Navegación */
.menu-botones-principal, .sub-menu {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 25px;
}

.btn-menu, .btn-sub-menu {
  background: transparent;
  color: var(--color-fucsia);
  border: 2px solid var(--color-fucsia);
  padding: 10px 18px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: bold;
  font-size: 0.95rem;
}

.btn-menu.active, .btn-sub-menu.active, .btn-menu:hover {
  background: var(--color-fucsia);
  color: #FFFFFF;
}

/* Campos de Formulario */
.campo {
  margin-bottom: 18px;
}

label {
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
  color: var(--color-label);
  font-size: 0.92rem;
}

input[type="text"], select, textarea {
  width: 100%;
  padding: 12px;
  border-radius: 10px;
  border: 1.5px solid var(--color-bordes);
  background-color: var(--color-input-bg);
  color: var(--color-texto);
  font-size: 0.95rem;
  outline: none;
}

input:focus, select:focus, textarea:focus {
  border-color: var(--color-fucsia);
}

.textarea-readonly {
  background-color: var(--color-card-bg);
  border-color: var(--color-fucsia);
}

/* Botones Principales y Secundarios */
.centrar-btn {
  display: flex;
  justify-content: center;
  margin: 15px 0;
}

.botones-accion {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 15px;
  flex-wrap: wrap;
}

.btn-principal {
  background-color: var(--color-fucsia);
  color: white;
  border: none;
  padding: 12px 22px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: bold;
}

.btn-secundario {
  background-color: transparent;
  color: var(--color-fucsia);
  border: 1.5px solid var(--color-fucsia);
  padding: 10px 18px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: bold;
}

.recuadro-card {
  background: var(--color-card-bg);
  border: 1.5px solid var(--color-fucsia);
  padding: 20px;
  border-radius: 14px;
}

.caja-texto-preview {
  white-space: pre-wrap;
  background: var(--color-input-bg);
  padding: 10px;
  border-radius: 8px;
  margin-top: 5px;
}

/* Switch SÍ / NO */
.toggle-container {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 15px;
  font-weight: bold;
}

.switch {
  position: relative;
  display: inline-block;
  width: 52px;
  height: 28px;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  cursor: pointer;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: #ccc;
  transition: .4s;
}

.slider:before {
  position: absolute;
  content: "";
  height: 20px;
  width: 20px;
  left: 4px;
  bottom: 4px;
  background-color: white;
  transition: .4s;
}

input:checked + .slider {
  background-color: var(--color-fucsia);
}

input:checked + .slider:before {
  transform: translateX(24px);
}

.slider.round {
  border-radius: 34px;
}

.slider.round:before {
  border-radius: 50%;
}

.margin-top {
  margin-top: 20px;
}

.mensaje-estado {
  margin-top: 10px;
  font-weight: bold;
  text-align: center;
  color: var(--color-fucsia);
}
